rules_version = '2';
/**
 * STone — Firestore Security Rules
 * Deploy: firebase deploy --only firestore:rules
 *
 * Admin (อ่าน deviceHeartbeats): เฉพาะ Google account uburiram@gmail.com
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'uburiram@gmail.com';
    }

    function heartbeatKeysOk(deviceId) {
      let k = request.resource.data.keys();
      return k.hasOnly([
        'deviceId', 'firstSeen', 'lastSeen', 'os', 'browser', 'userAgent',
        'language', 'timezone', 'screen', 'isPwa', 'lastAuthUid', 'lastIp',
        'app', 'pingCount'
      ])
      && request.resource.data.deviceId is string
      && request.resource.data.deviceId == deviceId
      && request.resource.data.app == 'STone'
      && request.resource.data.lastSeen is string;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /meta/{docId} {
        allow read, write: if isOwner(userId)
          && docId in ['settings'];
      }

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['id', 'type', 'date', 'amount'])
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.id is string
          && request.resource.data.id == txId;
        allow delete: if isOwner(userId);
      }
    }

    match /deviceHeartbeats/{deviceId} {
      allow read: if isAdmin();
      allow create: if heartbeatKeysOk(deviceId)
        && request.resource.data.keys().hasAll(['deviceId', 'lastSeen', 'firstSeen', 'app']);
      allow update: if heartbeatKeysOk(deviceId)
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.firstSeen == resource.data.firstSeen;
      allow delete: if isAdmin();
    }
  }
}
